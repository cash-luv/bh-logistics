rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // DailyLogs 사진: dailyLogs/{yearMonth}/{logId}/{fileName}
    // 본인 로그 경로({workDate}_{uid})에만 쓰기 허용, 이미지 파일만, 최대 10MB 제한
    match /dailyLogs/{yearMonth}/{logId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        logId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '$') &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024;
    }

    // 차량 주차 사진 등: vehicles/{vehicleId}/{allPaths=**}
    match /vehicles/{vehicleId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024;
    }
  }
}
